# ==============================================================================
# KINETIC TECH GYM PLATFORM — ENVIRONMENT VARIABLES CONFIGURATION
# ==============================================================================

# 1. SUPABASE CREDENTIALS (Wajib)
# Dapatkan dari Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# 2. PAYMENT GATEWAYS (Midtrans / Xendit)
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxx
MIDTRANS_IS_PRODUCTION=false

# 3. WHATSAPP BUSINESS NOTIFICATION GATEWAY (Twilio / Fonnte / Waha)
WHATSAPP_API_URL=https://api.fonnte.com/send
WHATSAPP_API_TOKEN=your-whatsapp-gateway-token

# 4. IOT GATE CONTROLLER CONFIGURATION (Untuk Raspberry Pi Cabang)
KINETIC_API_ENDPOINT=http://localhost:3000/api/gate/verify
KINETIC_CLUB_ID=cl_sudirman_01
KINETIC_DEVICE_CODE=TRN-ENTRY-01
RELAY_GPIO_PIN=17
